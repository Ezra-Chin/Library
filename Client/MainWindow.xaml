<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Client"
        Height="450"
        Width="500"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Total Records -->
        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Total Records:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="TotalNum"
                 Grid.Row="0"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- Index -->
        <Label Grid.Row="1"
               Grid.Column="0"
               Content="Record Index:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="IndexNum"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="5"/>

        <!-- First Name -->
        <Label Grid.Row="2"
               Grid.Column="0"
               Content="First Name:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="FNameBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- Last Name -->
        <Label Grid.Row="3"
               Grid.Column="0"
               Content="Last Name:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="LNameBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- Account Number -->
        <Label Grid.Row="4"
               Grid.Column="0"
               Content="Account Number:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="AcctNoBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- PIN -->
        <Label Grid.Row="5"
               Grid.Column="0"
               Content="PIN:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="PinBox"
                 Grid.Row="5"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- Balance -->
        <Label Grid.Row="6"
               Grid.Column="0"
               Content="Balance:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="BalanceBox"
                 Grid.Row="6"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>

        <!-- Button -->
        <Button x:Name="GoButton"
                Grid.Row="7"
                Grid.ColumnSpan="2"
                Content="Get Account"
                Width="150"
                Height="35"
                HorizontalAlignment="Center"
                Margin="10"
                Click="GoButton_Click"/>
        <Image x:Name="PhotoBox"
               Grid.Row="7"
               Grid.Column="1"
               Width = "120"
               Height = "150"
               Stretch = "Uniform"
               Margin="149,24,0,24"
               HorizontalAlignment="Left"/>

    </Grid>

</Window>