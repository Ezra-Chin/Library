<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Client"
        Height="600"
        Width="650"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>


        <!-- Search Last Name -->
        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Search Last Name:"
               VerticalAlignment="Center"/>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal">

            <TextBox x:Name="SearchBox"
                     Width="150"
                     Margin="5"/>

            <Button x:Name="SearchButton"
                    Content="Search"
                    Width="70"
                    Margin="5"
                    Click="SearchButton_Click"/>
        </StackPanel>


        <!-- Total Records -->
        <Label Grid.Row="1"
               Grid.Column="0"
               Content="Total Records:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="TotalNum"
                 Grid.Row="1"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- Record Index -->
        <Label Grid.Row="2"
               Grid.Column="0"
               Content="Record Index:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="IndexNum"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="5"/>


        <!-- Account Number -->
        <Label Grid.Row="3"
               Grid.Column="0"
               Content="Account Number:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="AcctNoBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- PIN -->
        <Label Grid.Row="4"
               Grid.Column="0"
               Content="PIN:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="PinBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- First Name -->
        <Label Grid.Row="5"
               Grid.Column="0"
               Content="First Name:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="FNameBox"
                 Grid.Row="5"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- Last Name -->
        <Label Grid.Row="6"
               Grid.Column="0"
               Content="Last Name:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="LNameBox"
                 Grid.Row="6"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- Balance -->
        <Label Grid.Row="7"
               Grid.Column="0"
               Content="Balance:"
               VerticalAlignment="Center"/>

        <TextBox x:Name="BalanceBox"
                 Grid.Row="7"
                 Grid.Column="1"
                 IsReadOnly="True"
                 Margin="5"/>


        <!-- Photo Box -->
        <Border Grid.Row="1"
                Grid.RowSpan="7"
                Grid.Column="2"
                BorderBrush="Gray"
                BorderThickness="1"
                Width="150"
                Height="180"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="10">

            <Image x:Name="PhotoBox"
                   Width="140"
                   Height="170"
                   Stretch="Uniform"/>
        </Border>


        <!-- Progress Bar -->
        <ProgressBar x:Name="SearchProgress"
                     Grid.Row="8"
                     Grid.ColumnSpan="2"
                     Height="20"
                     Margin="5"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed"/>


        <!-- Get Account Button -->
        <Button x:Name="GoButton"
                Grid.Row="9"
                Grid.ColumnSpan="2"
                Content="Get Account"
                Width="150"
                Height="35"
                HorizontalAlignment="Center"
                Margin="10"
                Click="GoButton_Click"/>

    </Grid>

</Window>